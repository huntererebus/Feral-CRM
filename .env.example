# --- Database (Neon Postgres — see planning-doc.md Section 9) ---
DATABASE_URL="postgresql://user:password@host/reel?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Base URL of the platform (used for email links, callback URLs)
AUTH_URL="http://localhost:3000"

# --- Tenancy / subdomain resolution ---
# The root domain the app is served on. In dev, {slug}.localhost:3000 works
# in most browsers without /etc/hosts edits.
APP_BASE_DOMAIN="reel.app"
APP_BASE_DOMAIN_DEV="localhost:3000"

# --- Object storage (Cloudflare R2 — see planning-doc.md Section 9) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="reel-media"

# --- Email (Resend — see planning-doc.md Section 9) ---
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM="Reel <notifications@reel.app>"
