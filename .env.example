# --- Database (Neon Postgres — see planning-doc.md Section 9) ---
DATABASE_URL="postgresql://user:password@host/reel?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Base URL of the platform (used for email links, callback URLs)
AUTH_URL="http://localhost:3000"

# --- OAuth sign-in (Google / Apple) — optional, credentials login always works without these ---
# Google Cloud Console -> APIs & Services -> Credentials. Authorized
# redirect URI must be exactly https://<APP_BASE_DOMAIN>/api/auth/callback/google
# — never a per-org subdomain URL; see auth.ts's redirectProxyUrl comment.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple Developer -> Certificates, Identifiers & Profiles. APPLE_CLIENT_SECRET
# is a JWT you generate yourself (signed with your Apple private key), not a
# static string — it expires (up to 6 months) and must be regenerated; see
# SETUP.md's OAuth section. Authorized redirect URI, same rule as Google:
# exactly https://<APP_BASE_DOMAIN>/api/auth/callback/apple, never per-org.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Tenancy / subdomain resolution ---
# The root domain the app is served on. In dev, {slug}.localhost:3000 works
# in most browsers without /etc/hosts edits.
APP_BASE_DOMAIN="reel.app"
APP_BASE_DOMAIN_DEV="localhost:3000"

# --- Object storage (Cloudflare R2 — see planning-doc.md Section 9) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="reel-media"

# --- Email (Resend — see planning-doc.md Section 9) ---
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM="Reel <notifications@reel.app>"
